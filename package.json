{
  "name": "qbrowse",
  "productName": "QBrowse",
  "author": {
    "name": "QuBI",
    "email": "qu@qubirpi3b.tk"
  },
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "electron:dev": "concurrently -k \"vite\" \"cross-env NODE_ENV=development wait-on http://localhost:1420 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "build:app": "vite build && electron-builder build --win --x64",
    "build:linux": "vite build && electron-builder build --linux --x64"
  },
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.34.0",
    "@ghostery/adblocker-electron": "^2.18.1",
    "@huggingface/transformers": "^4.2.0",
    "@xenova/transformers": "^2.17.2",
    "adm-zip": "^0.6.0",
    "cross-fetch": "^4.1.0",
    "firebase": "^12.16.0",
    "jimp": "^1.6.1",
    "lucide-react": "^0.300.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tesseract.js": "^7.0.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "postcss": "^8.4.32",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.10",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.qbrowse.app",
    "productName": "QBrowse",
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "icon": "icon.png"
    },
    "asar": true,
    "asarUnpack": [
      "electron/bin/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "linux": {
      "target": [
        "deb",
        "AppImage"
      ]
    }
  }
}