{
  "name": "qbrowse",
  "productName": "QBrowse",
  "desktopName": "QBrowse",
  "description": "Next-generation privacy-first browser with built-in Tor onion routing, local Gemma AI, and encrypted cloud sync.",
  "author": {
    "name": "QuBI",
    "email": "qu@qubirpi3b.tk"
  },
  "private": false,
  "license": "MIT",
  "version": "1.6.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build:rust": "node scripts/build-rust.cjs",
    "build:preload": "node scripts/build-preload.cjs",
    "electron:dev": "npm run build:rust && npm run build:preload && concurrently -k \"vite\" \"cross-env NODE_ENV=development wait-on -i 80 tcp:1420 && electron .\"",
    "electron:start": "npm run build && electron .",
    "start": "npm run build && electron .",
    "build": "npm run build:rust && npm run build:preload && vite build",
    "preview": "vite preview",
    "build:app": "npm run build && electron-builder build --win --x64 --publish never",
    "build:win": "npm run build && electron-builder build --win --x64 --publish never",
    "build:linux": "npm run build && electron-builder build --linux --x64 --publish never",
    "build:linux:arm64": "npm run build && electron-builder build --linux --arm64 --publish never",
    "build:all": "npm run build && electron-builder build -w -l --x64 --publish never",
    "build:installer": "node scripts/build-installer.cjs"
  },
  "dependencies": {
    "cross-fetch": "^4.1.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.16",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^43.8.12",
    "electron-builder": "^26.18.0",
    "electron-is-dev": "^3.0.1",
    "firebase": "^12.19.0",
    "lucide-react": "^0.300.0",
    "pdfjs-dist": "^6.5.438",
    "postcss": "^8.5.33",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.0",
    "vite": "^7.3.8",
    "wait-on": "^9.5.1",
    "zustand": "^4.5.0",
    "@xenova/transformers": "^2.17.2"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7",
    "@xmldom/xmldom": "^0.8.15",
    "axios": "^1.21.1",
    "baseline-browser-mapping": "^2.11.39",
    "brace-expansion@<=1.1.20": "^1.1.22",
    "brace-expansion@>=2.0.0 <=2.1.6": "^2.1.8",
    "brace-expansion@>=4.0.0 <=5.0.11": "^5.1.0",
    "browserslist": "^4.29.6",
    "fast-uri": "^3.1.9",
    "follow-redirects": "^1.16.3",
    "joi": "^18.3.2",
    "js-yaml": "^4.3.2",
    "minimatch@>=7.0.0 <=11.0.0": "^11.0.9",
    "nanoid": "^3.3.20",
    "postcss-selector-parser": "^6.1.6",
    "protobufjs": "^7.6.6",
    "shell-quote": "^1.12.0",
    "source-map-js": "^1.2.4",
    "tar": "^7.5.23",
    "undici@<=6.29.0": "^6.29.1",
    "undici@>=7.0.0 <=7.30.0": "^7.30.2"
  },
  "build": {
    "appId": "com.qbrowse.app",
    "productName": "QBrowse",
    "executableName": "QBrowse",
    "copyright": "Copyright © 2026 QuBI",
    "compression": "maximum",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "electron/native/*.node",
      "electron/webview_preload.min.cjs",
      "icon.png",
      "!electron/bin/**/*",
      "!**/*.map"
    ],
    "publish": {
      "provider": "github",
      "owner": "Qu-Bi",
      "repo": "QBrowse",
      "releaseType": "release"
    },
    "protocols": [
      {
        "name": "HTTP",
        "schemes": [
          "http"
        ]
      },
      {
        "name": "HTTPS",
        "schemes": [
          "https"
        ]
      }
    ],
    "directories": {
      "output": "dist_electron"
    },
    "win": {
      "icon": "icon.png",
      "artifactName": "${productName}-Setup-${version}-x64.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "legalTrademarks": "QBrowse"
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-x64.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "QBrowse",
      "runAfterFinish": true,
      "differentialPackage": true
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "pacman",
        "tar.gz"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Network;WebBrowser;",
      "icon": "icon.png",
      "maintainer": "QuBI <qu@qubirpi3b.tk>",
      "vendor": "QuBI",
      "synopsis": "Next-generation privacy browser with Tor, AI & Cloud Sync",
      "description": "Next-generation privacy-first browser with built-in Tor onion routing, local Gemma AI, and encrypted cloud sync.",
      "mimeTypes": [
        "text/html",
        "text/xml",
        "application/xhtml+xml",
        "application/xml",
        "x-scheme-handler/http",
        "x-scheme-handler/https",
        "x-scheme-handler/qbrowse"
      ],
      "desktop": {
        "entry": {
          "Name": "QBrowse",
          "GenericName": "Web Browser",
          "Comment": "Next-generation privacy-first browser with built-in Tor onion routing, local Gemma AI, and encrypted cloud sync.",
          "StartupWMClass": "QBrowse",
          "StartupNotify": "true",
          "Keywords": "browser;web;internet;privacy;tor;ai;"
        },
        "desktopActions": {
          "new-window": {
            "Name": "New Window",
            "Exec": "QBrowse --new-window %U"
          },
          "new-private-window": {
            "Name": "New Incognito Window",
            "Exec": "QBrowse --incognito %U"
          }
        }
      }
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "artifactName": "${name}_${version}_${arch}.${ext}",
      "priority": "optional",
      "packageCategory": "web",
      "compression": "xz"
    },
    "rpm": {
      "artifactName": "${name}-${version}.${arch}.${ext}",
      "packageCategory": "Applications/Internet",
      "compression": "xzmt"
    },
    "pacman": {
      "artifactName": "${name}-${version}-${arch}.${ext}",
      "compression": "xz"
    }
  }
}
